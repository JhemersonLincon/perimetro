# Configurações do Banco de Dados PostgreSQL
POSTGRES_USER=cronica_user
POSTGRES_PASSWORD=cronica_secret_pass
POSTGRES_DB=cronica_rpg
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cronica_user:cronica_secret_pass@localhost:5432/cronica_rpg

# Configurações de Segurança da API (Back-end)
SECRET_KEY=cronica_super_secret_jwt_key_change_in_production_2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Configurações do Front-end
VITE_API_URL=http://localhost:8000/api
